// This file is compiled into the Kally executable at build time.  Keep its
// input bounded: Kally's lockfile format is intentionally line-oriented.
public bool kally_lock_version_supported(u32 version) { return version == 1; }

public bool kally_valid_name(String[65] name) {
    u32 length = Text.length(name);
    if length == 0 || length > 64 { return false; }
    u32 index = 0;
    while index < length {
        u8 byte = Text.byte_at(name, index);
        bool allowed = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 45 || byte == 95;
        if !allowed { return false; }
        index += 1;
    }
    return true;
}

// 1=Git, 2=local path, 0=unsupported/malformed.  The transport choice is
// policy, so it lives in KLC; Rust only performs the selected I/O.
public u32 kally_source_kind(String[512] source) {
    u32 length = Text.length(source);
    if length > 4 && Text.byte_at(source, 0) == 103 && Text.byte_at(source, 1) == 105 && Text.byte_at(source, 2) == 116 && Text.byte_at(source, 3) == 58 { return 1; }
    if length > 5 && Text.byte_at(source, 0) == 112 && Text.byte_at(source, 1) == 97 && Text.byte_at(source, 2) == 116 && Text.byte_at(source, 3) == 104 && Text.byte_at(source, 4) == 58 { return 2; }
    return 0;
}

public bool kally_hex_byte(u8 byte) {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102);
}

// Git refs recorded in a lockfile are immutable object IDs, never branch
// names.  Keeping this test in KLC makes the resolver's invariant explicit.
public bool kally_revision_valid(String[128] revision) {
    u32 length = Text.length(revision);
    if length < 7 || length > 64 { return false; }
    u32 index = 0;
    while index < length {
        if !kally_hex_byte(Text.byte_at(revision, index)) { return false; }
        index += 1;
    }
    return true;
}

public bool kally_checksum_valid(String[17] checksum) {
    u32 length = Text.length(checksum);
    if length != 16 { return false; }
    u32 index = 0;
    while index < length {
        if !kally_hex_byte(Text.byte_at(checksum, index)) { return false; }
        index += 1;
    }
    return true;
}

public bool kally_reference_valid(String[256] reference) {
    u32 length = Text.length(reference);
    if length == 0 { return false; }
    u32 index = 0;
    while index < length {
        u8 byte = Text.byte_at(reference, index);
        if byte <= 32 || byte == 127 { return false; }
        index += 1;
    }
    return true;
}

public bool kally_source_matches(String[512] left, String[512] right) {
    u32 length = Text.length(left);
    if length != Text.length(right) { return false; }
    u32 index = 0;
    while index < length {
        if Text.byte_at(left, index) != Text.byte_at(right, index) { return false; }
        index += 1;
    }
    return true;
}

public bool kally_reference_matches(String[256] left, String[256] right) {
    u32 length = Text.length(left);
    if length != Text.length(right) { return false; }
    u32 index = 0;
    while index < length {
        if Text.byte_at(left, index) != Text.byte_at(right, index) { return false; }
        index += 1;
    }
    return true;
}

// 0=keep an exact lock, 1=perform the first resolution, 2=manifest/lock
// divergence (requires explicit `kally update`), 255=invalid request.
public u32 kally_resolution_action(u32 requested_kind, u32 locked_kind, bool has_lock, bool source_matches, bool reference_matches) {
    if requested_kind != 1 && requested_kind != 2 { return 255; }
    if !has_lock { return 1; }
    if locked_kind != requested_kind { return 2; }
    if !source_matches || !reference_matches { return 2; }
    return 0;
}

public bool kally_git_source_valid(String[512] source) {
    if kally_source_kind(source) != 1 { return false; }
    u32 length = Text.length(source);
    u32 index = 4;
    bool in_subdir = false;
    u32 dots = 0;
    while index < length {
        u8 byte = Text.byte_at(source, index);
        if byte == 32 || byte == 9 || byte < 32 { return false; }
        if byte == 35 {
            if in_subdir || index == 4 || index + 1 >= length { return false; }
            if Text.byte_at(source, index + 1) == 47 || Text.byte_at(source, index + 1) == 92 { return false; }
            in_subdir = true;
            dots = 0;
        } else if in_subdir {
            if byte == 92 { return false; }
            if byte == 47 {
                if dots == 2 { return false; }
                dots = 0;
            } else {
                if byte == 46 { dots += 1; } else { dots = 0; }
            }
        }
        index += 1;
    }
    return dots != 2;
}

public bool kally_path_source_valid(String[512] source) {
    if kally_source_kind(source) != 2 { return false; }
    u32 length = Text.length(source);
    if Text.byte_at(source, 5) == 47 || Text.byte_at(source, 5) == 92 { return false; }
    u32 index = 5;
    while index < length {
        u8 byte = Text.byte_at(source, index);
        if byte <= 32 || byte == 127 { return false; }
        index += 1;
    }
    return true;
}

public bool kally_local_reference_valid(String[256] reference) {
    return Text.length(reference) == 5
        && Text.byte_at(reference, 0) == 108
        && Text.byte_at(reference, 1) == 111
        && Text.byte_at(reference, 2) == 99
        && Text.byte_at(reference, 3) == 97
        && Text.byte_at(reference, 4) == 108;
}

// `=` belongs to Kally's grammar, not to its filesystem adapter.
public u32 kally_lock_value_start(String[512] line) {
    u32 index = 0;
    u32 length = Text.length(line);
    while index < length {
        if Text.byte_at(line, index) == 61 { return index + 1; }
        index += 1;
    }
    return 0;
}

// Lockfile parser state: 0=fresh, 32=header, 16..31=current package where
// bits 0..3 mean source/reference/revision/checksum.  255 is a syntax error.
// The host only stores values after this KLC transition accepts the event.
public u32 kally_lock_transition(u32 state, u32 kind) {
    if kind == 0 { return state; }
    if kind == 1 {
        if state == 0 { return 32; }
        return 255;
    }
    if kind == 2 {
        if state == 0 || state == 32 || state == 31 { return 16; }
        return 255;
    }
    if kind == 3 {
        if state == 16 || state == 18 || state == 20 || state == 22 || state == 24 || state == 26 || state == 28 || state == 30 { return state + 1; }
        return 255;
    }
    if kind == 4 {
        if state == 16 || state == 17 || state == 20 || state == 21 || state == 24 || state == 25 || state == 28 || state == 29 { return state + 2; }
        return 255;
    }
    if kind == 5 {
        if state == 16 || state == 17 || state == 18 || state == 19 || state == 24 || state == 25 || state == 26 || state == 27 { return state + 4; }
        return 255;
    }
    if kind == 6 {
        if state == 16 || state == 17 || state == 18 || state == 19 || state == 20 || state == 21 || state == 22 || state == 23 { return state + 8; }
        return 255;
    }
    return 255;
}

public bool kally_lock_complete(u32 state) {
    return state == 0 || state == 32 || state == 31;
}

// Manifest state is deliberately separate from the lock state: a manifest
// contains requested source/reference pairs; revision and checksum belong only
// to kally.lock.  0=fresh, 32=header, 16..19=active package, 255=invalid.
public u32 kally_manifest_transition(u32 state, u32 kind) {
    if kind == 0 { return state; }
    if kind == 1 {
        if state == 0 { return 32; }
        return 255;
    }
    if kind == 2 {
        if state == 0 || state == 32 || state == 19 { return 16; }
        return 255;
    }
    if kind == 3 {
        if state == 16 || state == 18 { return state + 1; }
        return 255;
    }
    if kind == 4 {
        if state == 16 || state == 17 { return state + 2; }
        return 255;
    }
    return 255;
}

public bool kally_manifest_complete(u32 state) {
    return state == 0 || state == 32 || state == 19;
}

// 0=blank/comment, 1=version, 2=package section, 3..6=properties, 255=bad.
public u32 kally_lock_line_kind(String[512] line) {
    u32 length = Text.length(line);
    if length == 0 { return 0; }
    u8 first = Text.byte_at(line, 0);
    if first == 35 { return 0; }
    if first == 91 && Text.byte_at(line, length - 1) == 93 { return 2; }
    if length == 9 && Text.byte_at(line, 0) == 118 && Text.byte_at(line, 1) == 101 && Text.byte_at(line, 2) == 114 && Text.byte_at(line, 3) == 115 && Text.byte_at(line, 4) == 105 && Text.byte_at(line, 5) == 111 && Text.byte_at(line, 6) == 110 && Text.byte_at(line, 7) == 61 && Text.byte_at(line, 8) == 49 { return 1; }
    if length >= 7 && Text.byte_at(line, 0) == 115 && Text.byte_at(line, 1) == 111 && Text.byte_at(line, 2) == 117 && Text.byte_at(line, 3) == 114 && Text.byte_at(line, 4) == 99 && Text.byte_at(line, 5) == 101 && Text.byte_at(line, 6) == 61 { return 3; }
    if length >= 10 && Text.byte_at(line, 0) == 114 && Text.byte_at(line, 1) == 101 && Text.byte_at(line, 2) == 102 && Text.byte_at(line, 3) == 101 && Text.byte_at(line, 4) == 114 && Text.byte_at(line, 5) == 101 && Text.byte_at(line, 6) == 110 && Text.byte_at(line, 7) == 99 && Text.byte_at(line, 8) == 101 && Text.byte_at(line, 9) == 61 { return 4; }
    if length >= 9 && Text.byte_at(line, 0) == 114 && Text.byte_at(line, 1) == 101 && Text.byte_at(line, 2) == 118 && Text.byte_at(line, 3) == 105 && Text.byte_at(line, 4) == 115 && Text.byte_at(line, 5) == 105 && Text.byte_at(line, 6) == 111 && Text.byte_at(line, 7) == 110 && Text.byte_at(line, 8) == 61 { return 5; }
    if length >= 9 && Text.byte_at(line, 0) == 99 && Text.byte_at(line, 1) == 104 && Text.byte_at(line, 2) == 101 && Text.byte_at(line, 3) == 99 && Text.byte_at(line, 4) == 107 && Text.byte_at(line, 5) == 115 && Text.byte_at(line, 6) == 117 && Text.byte_at(line, 7) == 109 && Text.byte_at(line, 8) == 61 { return 6; }
    return 255;
}
