// Standard library implemented in KLC. Imported with: use std.easing;
public i16 step_towards(i16 value, i16 target, i16 step) {
    if (value < target) {
        i16 next = value + step;
        if (next > target) { return target; }
        return next;
    }
    if (value > target) {
        i16 next = value - step;
        if (next < target) { return target; }
        return next;
    }
    return value;
}
