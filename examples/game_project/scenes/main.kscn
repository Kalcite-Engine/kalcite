[scene]
root = "Main"

[node "Main"]
script = "Main"

[node "Player" parent="Main"]
script = "Player"
speed = 2

@signal Main/Player.core_collected -> Main.on_core_collected
@signal Main/Player.collided -> Main.on_player_collided
@signal Main/Player.quest_finished -> Main.on_finished
@signal Main/Player.restarted -> Main.on_restarted
@autoload State GameState
