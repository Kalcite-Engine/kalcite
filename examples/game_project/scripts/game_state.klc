@autoload
public class GameState extend Node {
    u16 launches = 0;

    public void Ready() {
        launches += 1;
        ProjectSave.set_score("GAME_STATE", 41);
        u32 restored = ProjectSave.score("GAME_STATE", 0);
        if restored == 41 && !ProjectSave.compatible(ProjectSave.version() + 1, ProjectSave.schema()) {
            launches += 1;
        }
        Audio.tone(880, 30, 64);
    }
}
