@scene
class Main extends Game {
    var score: u32 = 0;
    fn update() -> void {
        if Input.held(Key.Left) { score += 1; }
    }

    fn on_player_moved(value: i16) -> void {
        score += 1;
    }

    fn draw() -> void {
        Draw.clear(Color.Black);
        Draw.camera(1, 0);
        Draw.tilemap("level.csv", "mascot-sheet.png", 32, 32, 0, 0);
        Draw.sprite_region("mascot-sheet.png", 12, 72, 32, 0, 32, 32);
        Draw.sprite_frame("mascot.ksheet", 0, 52, 72);
        if score > 0 {
            Draw.rect(0, 0, 4, 4, Color.White);
        }
    }
}
