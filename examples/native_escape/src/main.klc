@scene
public class NativeEscapeDemo extend Game {
    u32 ticks = 0;

    public void Update() {
        ticks += 1;

        // Compiled only by desktop pipelines.
        unsafe rust[desktop] {
            core::hint::black_box(self.ticks);
        }

        // Compiled only for NumWorks (ARM bare metal).
        unsafe rust[numworks] {
            core::hint::spin_loop();
        }

        // The body is passed directly to core::arch::asm!(...).
        unsafe asm[numworks] {
            "nop",
            options(nomem, nostack)
        }
    }

    public void Draw() {
        Draw.clear(Color.Black);
        Draw.text("NATIVE ESCAPE", 8, 8, Color.Green, Color.Black);
        Draw.number(ticks, 8, 28, Color.White, Color.Black);
    }
}
