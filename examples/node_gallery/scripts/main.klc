@scene
public class Main extend Game {
    private u16 activated = 0;

    public void on_start() {
        activated = 1;
    }

    public void on_options() {
        activated = 2;
    }

    public void Draw() {
        Draw.clear(Color.Black);
        Draw.text("SELECTED", 18, 112, Color.White, Color.Black);
        Draw.number(activated, 50, 128, Color.Yellow, Color.Black);
    }
}
