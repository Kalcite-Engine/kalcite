@scene
public class PoolDemo extend Game {
    @pool(8)
    public class Bullet extend Entity {
        Vec2fx position = Vec2fx(20, 120);
        Vec2fx velocity = Vec2fx(2, 0);

        public void Update() {
            position += velocity;
        }
    }

    Pool[Bullet; 8] bullets;
    Handle[Bullet] last_bullet;

    public void Update() {
        if (!last_bullet.is_valid()) {
            last_bullet = bullets.spawn(Bullet.new());
        }

        if (Input.held(Key.Back) && last_bullet.is_valid()) {
            bullets.despawn(last_bullet);
            last_bullet = Handle.invalid();
        }
    }

    public void Draw() {
        Draw.clear(Color.Black);
        Draw.rect(10, 10, 100, 16, Color.Green);
    }
}
